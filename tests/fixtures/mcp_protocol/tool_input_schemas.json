{
  "finboard_job_wait": {
    "input_schema": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "poll_interval_seconds": {
          "default": 2,
          "title": "Poll Interval Seconds",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "_waitArguments",
      "type": "object"
    }
  },
  "finboard_run_list": {
    "input_schema": {
      "properties": {
        "limit": {
          "default": 50,
          "title": "Limit",
          "type": "integer"
        },
        "statuses": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statuses"
        },
        "strategy_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy Kind"
        }
      },
      "title": "_listArguments",
      "type": "object"
    }
  },
  "finboard_run_queue": {
    "input_schema": {
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "payload"
      ],
      "title": "_queueArguments",
      "type": "object"
    }
  },
  "finboard_source_check": {
    "input_schema": {
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "ref_id"
      ],
      "title": "sourceArguments",
      "type": "object"
    }
  },
  "finboard_topic_read": {
    "input_schema": {
      "properties": {
        "entries": {
          "default": false,
          "title": "Entries",
          "type": "boolean"
        },
        "entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "limit": {
          "default": 20,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "refs": {
          "default": 10,
          "title": "Refs",
          "type": "integer"
        },
        "rounds": {
          "default": 10,
          "title": "Rounds",
          "type": "integer"
        },
        "sort": {
          "default": "updated",
          "title": "Sort",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        },
        "view": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View"
        }
      },
      "title": "readArguments",
      "type": "object"
    }
  },
  "finboard_topic_write": {
    "input_schema": {
      "properties": {
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        }
      },
      "required": [
        "operation",
        "payload"
      ],
      "title": "writeArguments",
      "type": "object"
    }
  }
}
