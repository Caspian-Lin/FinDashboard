# =============================================================================
# FinDashboard 环境变量样板(复制为 .env 后填入实际值)。
#
# 所有变量前缀 ``FINBOARD_``;pydantic-settings 自动加载 .env。
# 敏感字段(password / auth_code)在日志中会被 structlog 脱敏(见
# finboard_app/logging.py)。
# =============================================================================

# ====== 运行环境 ======
# dev / staging / prod / ci
# dev 环境下日志默认走 Console renderer(彩色),其余环境走 JSON
FINBOARD_ENV=dev
FINBOARD_LOG_LEVEL=INFO
FINBOARD_LOG_JSON=false

# ====== 数据库(PostgreSQL 16+)======
#
# 1. 先在本机用 postgres 超级用户创建专用账户与数据库,见 README §快速开始。
# 2. 把 CHANGE_ME 替换为创建账户时设置的强密码。
# 3. CI 里用 docker compose 起的 postgres,默认用户/密码/库都是 findashboard。
#
# 注意:Python 异步驱动走 psycopg v3,driver 写 ``postgresql+psycopg``;
#       若直接复制 psql 的 ``postgresql://`` 会被 SQLAlchemy 拒绝。
FINBOARD_DB_URL=postgresql+psycopg://findashboard:CHANGE_ME@127.0.0.1:5432/findashboard
FINBOARD_DB_POOL_SIZE=5
FINBOARD_DB_MAX_OVERFLOW=10

# 历史行情：2000 积分可用于 A 股 daily/adj_factor；2026-09-06 实测 index_daily/fund_daily
# 2000 积分档亦可调（fund_daily 官方文档标 5000 与实测不符，issue #341）。
FINBOARD_DATA_PROVIDER=tushare
FINBOARD_DATA_FALLBACK_PROVIDER=akshare
FINBOARD_TUSHARE_TOKEN=
FINBOARD_TUSHARE_REQUESTS_PER_MINUTE=200
FINBOARD_TUSHARE_DAILY_REQUEST_LIMIT=100000
FINBOARD_TUSHARE_USAGE_FILE=data_cache/tushare_usage.json
# ParquetCache 进程内读缓存的近似字节上限(#440);空/不设 = 不限(默认)。
# 注意是近似计量:条目按「元素数 × 每元素实测平均字节」估算(Bar ~800B、
# close 点位 ~224B、列式 ~64B),非精确内存占用。长 run(bulk_download /
# multi_period 回放)的工作集可达数百 MB,建议 512MB;0 表示不缓存任何条目。
# FINBOARD_READ_CACHE_MAX_BYTES=536870912
# 因子实验室特征快照的跨标的并发读取数(研究域)
FINBOARD_FEATURE_SNAPSHOT_MAX_CONCURRENCY=8
FINBOARD_FEATURE_SNAPSHOT_PROCESS_WORKERS=8
# research_run 多期回放逐期价格特征重算的常驻进程池 worker 数(#288,研究域);
# 0 表示只用进程内协程池(旧行为)
FINBOARD_RESEARCH_PRICE_FEATURE_PROCESS_WORKERS=4

# ====== Broker 选型 ======
# mock / qmt / ctp
# - mock:本地开发与 CI 默认,完整模拟下单 / 成交 / 撤单链路
# - qmt:  P1 接入 A 股(需 Windows + QMT 客户端 + xtquant)
# - ctp:  P1 接入期货(需券商提供的 CTP SDK)
FINBOARD_BROKER=mock
FINBOARD_ACCOUNT_ID=test-account

# ====== QMT(迅投 xtquant)凭据 ======
# 仅当 FINBOARD_BROKER=qmt 时生效;xtquant 需要 mini QMT 客户端已登录
#
# PATH:miniQMT 安装目录下的 userdata_mini 文件夹完整路径
#   例:C:\国金QMT交易端\userdata_mini
# SESSION_ID:会话号(正整数),同时运行的多个策略/进程必须互不重复
#
# 注意:FINBOARD_ACCOUNT_ID 应填 QMT 资金账号(如 12345678),
#       xtquant 用此账号订阅交易回调。
FINBOARD_QMT_PATH=
FINBOARD_QMT_SESSION_ID=

# ====== CTP(期货)凭据 ======
# 仅当 FINBOARD_BROKER=ctp 时生效;仿真环境可用 openctp
FINBOARD_CTP_FRONT_ADDR=
FINBOARD_CTP_BROKER_ID=
FINBOARD_CTP_USER_ID=
FINBOARD_CTP_PASSWORD=
FINBOARD_CTP_APP_ID=
FINBOARD_CTP_AUTH_CODE=

# ====== 风控初值(与 phase1_doc.md §6.2 一致)======
# 上线前必须重新校准;默认值偏严格 —— 宁可慢,不可错
FINBOARD_RISK_MAX_ORDER_VALUE=10000
FINBOARD_RISK_MAX_SYMBOL_POSITION_VALUE=30000
FINBOARD_RISK_MAX_DAILY_BUY_VALUE=50000
FINBOARD_RISK_MAX_ACTIVE_ORDERS=10
FINBOARD_RISK_MAX_ORDERS_PER_MINUTE=5
FINBOARD_RISK_ALLOW_SHORT=false
FINBOARD_RISK_ALLOW_MARKET_ORDER=false

# ====== Kill Switch 初始态 ======
# 启动时是否直接进入"暂停新单"模式(off / no_new_orders / reduce_only / cancel_all / halt)
# 盘前设为 no_new_orders,人工核对后再通过 CLI / API 放行
FINBOARD_KILL_SWITCH_INITIAL=off

# ====== OpenCode 研究运行时======
# OpenCode 作为受控研究 Agent 运行时,通过 finboard-mcp 访问研究能力。
# 不连接实盘账户 / 订单 / 持仓;内置 bash/edit/write 工具默认拒绝。
# 默认全部关闭;启用前需先安装 OpenCode(建议固定版本)。

# --- 会话关联:opencode serve 的 HTTP API ---
FINBOARD_OPENCODE_ENABLED=false
FINBOARD_OPENCODE_BASE_URL=http://127.0.0.1:4096
FINBOARD_OPENCODE_DEFAULT_AGENT=finboard-researcher

# --- FinBoard MCP Server(#108,Docker 隔离前置)---
# 向外置研究 Agent(OpenCode)暴露受控研究工具的 MCP 服务。默认关闭。
# 不连接实盘账户 / 订单 / 持仓;实盘能力永久不注册为工具。
FINBOARD_MCP_ENABLED=false
# stdio=本机子进程接入(无需鉴权);streamable-http/sse=跨网络(必须配 AUTH_TOKEN)。
# Docker 隔离模式下容器内 opencode 通过 host.docker.internal:8765 访问,需 HTTP + token。
FINBOARD_MCP_TRANSPORT=stdio
FINBOARD_MCP_HOST=127.0.0.1
FINBOARD_MCP_PORT=8765
# HTTP 传输的 Bearer token;空则 stdio 模式忽略,HTTP 模式拒绝启动(防裸奔)。
# opencode_web_enabled 时必须设置:容器内 opencode 经 host.docker.internal:8765
# 访问内嵌 MCP server,该 token 同时注入容器(FINBOARD_OPENCODE_ENV_OVERRIDES 不含它,
# 由 process_manager 的 -e FINBOARD_MCP_TOKEN 单独注入)。
# 敏感字段:不进入日志 / 审计 / Provenance(AGENTS.md 红线)。
FINBOARD_MCP_AUTH_TOKEN=
# 只读模式:禁用所有写工具(审批门也不开放),只暴露查询与 AI 问答。
FINBOARD_MCP_READONLY_ONLY=false
# 审计是否额外持久化到研究审计表(默认仅结构化日志 + 内存副本)。
FINBOARD_MCP_AUDIT_PERSIST=false

# --- Web 研究工作台网关(#118 / Docker 隔离)---
# FinBoard 托管一个容器级隔离的 opencode web 容器,前端 iframe 跨源嵌入。
# 需要 Docker Desktop 运行。关闭时网关返回 503,前端隐藏入口。
FINBOARD_OPENCODE_WEB_ENABLED=false
# true=FinBoard 自动 docker run/stop opencode web 容器;false=外部已启动,仅连接。
FINBOARD_OPENCODE_MANAGE_PROCESS=false
# Docker 镜像(官方 ghcr.io/anomalyco/opencode;旧 ghcr.io/sst/opencode 已废弃)。
FINBOARD_OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest
# 固定容器名(便于 docker stop/logs/inspect)。
FINBOARD_OPENCODE_CONTAINER_NAME=finboard-opencode-web
# Web 实例端口(默认 4097,与 serve 的 4096 区分)。
FINBOARD_OPENCODE_WEB_PORT=4097
# 监听地址:容器隔离强制 127.0.0.1(宿主机侧);容器内 opencode 绑 0.0.0.0。
FINBOARD_OPENCODE_WEB_HOSTNAME=127.0.0.1
# 允许跨源访问的浏览器源(逗号分隔);iframe 嵌入必须显式允许 FinBoard 源。
# 开发期前端 dev server 例:http://localhost:5173,http://localhost:8000
FINBOARD_OPENCODE_WEB_CORS_ORIGINS=http://localhost:5173
# basic auth 凭证;密码留空则启动时自动生成强随机值并记入启动日志。
FINBOARD_OPENCODE_WEB_USERNAME=opencode
FINBOARD_OPENCODE_WEB_PASSWORD=
# 宿主机侧工作目录(仓库根;含 .opencode/.agents,bind mount 进容器)。
FINBOARD_OPENCODE_WORKDIR=.
# docker CLI 日志路径(docker run/stop 的 stdout/stderr)。
FINBOARD_OPENCODE_LOG_PATH=.opencode/logs/opencode-web.log
# 注入容器的环境变量(逗号分隔 KEY=VAL);如 LLM provider Key。
# 严格语义:这些变量进容器,FinBoard 自身凭证(DB 密码/broker/API)不进容器。
# 例:ANTHROPIC_API_KEY=sk-xxx,DEEPSEEK_API_KEY=sk-xxx
FINBOARD_OPENCODE_ENV_OVERRIDES=
# 是否在 opencode_web_enabled 时由 API lifespan 内嵌启动 finboard-mcp HTTP server
# (uvicorn 后台任务,复用 mcp_host/mcp_port/mcp_auth_token)。默认开启:容器内 opencode
# 连 host.docker.internal:8765 时无需用户单独跑 python -m finboard_mcp。
# 设 false 回退到独立进程模式(向后兼容,需手动起 mcp-serve-http)。
FINBOARD_OPENCODE_EMBED_MCP=true

# ---------------------------------------------------------------------------
# 研究代码沙箱(#216;默认关闭:需 Docker Desktop + 已构建镜像
# finboard-research-sandbox:<kit版本>,CI 构建,见 docker/research-sandbox/)
# ---------------------------------------------------------------------------
# 开关:启用后 finboard_research_code_run 可在一次性容器内执行已通过
# 静态校验的因子代码(--network none / --read-only / 非 root / 资源限额)。
FINBOARD_RESEARCH_SANDBOX_ENABLED=false
# 沙箱容器墙钟超时(秒,默认 600)。全市场挂载的 factor_series_build 容器
# 600s 不够(#424 实测):本机跑全市场因子构建建议 5400。
FINBOARD_RESEARCH_SANDBOX_TIMEOUT_SECONDS=600

# 因子序列 parquet 工件根目录(issue #463):research_factor_series 的 values
# 落 canonical parquet(content_checksum = 文件 sha256)。默认相对仓库根
# data_cache/factor_series,worktree 共享 data_cache 时天然随 junction 共享。
#FINBOARD_FACTOR_SERIES_ARTIFACT_ROOT=data_cache/factor_series

# ---------------------------------------------------------------------------
# 后台 worker(通用;worker_zombie_no_progress_seconds 默认 3600)
# ---------------------------------------------------------------------------
# 「心跳新鲜但 (progress_done, phase) 指纹无变化」的僵尸判定阈值。长阶段
# 任务的指纹天然长时间不变:factor_series_build 的 execute 阶段(挂载物化
# +容器构建)实测可超 1 小时,默认 3600s 会误杀(#424)——跑因子构建的
# 本机 worker 建议 14400。
FINBOARD_WORKER_ZOMBIE_NO_PROGRESS_SECONDS=3600
