# ====== 运行环境 ======
# dev / staging / prod;dev 下默认启用更多调试日志
FINBOARD_ENV=dev
FINBOARD_LOG_LEVEL=INFO
# JSON 结构化日志开关;dev 下可关掉改用 console 渲染
FINBOARD_LOG_JSON=true

# ====== 数据库 ======
# 默认指向本仓库 docker-compose 起的 postgres,用户名/密码仅供本地开发
FINBOARD_DB_URL=postgresql+psycopg://finboard:finboard@127.0.0.1:5432/finboard
FINBOARD_DB_POOL_SIZE=5
FINBOARD_DB_MAX_OVERFLOW=10

# ====== Broker 选型 ======
# mock / qmt / ctp;P0 默认走 mock,实盘部署时改对应值
FINBOARD_BROKER=mock
FINBOARD_ACCOUNT_ID=test-account

# ====== QMT(迅投 xtquant) ======
# 仅当 FINBOARD_BROKER=qmt 时生效
FINBOARD_QMT_PATH=
FINBOARD_QMT_SESSION_ID=

# ====== CTP(期货) ======
# 仅当 FINBOARD_BROKER=ctp 时生效
FINBOARD_CTP_FRONT_ADDR=
FINBOARD_CTP_BROKER_ID=
FINBOARD_CTP_USER_ID=
FINBOARD_CTP_PASSWORD=
FINBOARD_CTP_APP_ID=
FINBOARD_CTP_AUTH_CODE=

# ====== 风控初值 ======
# 与 phase1_doc.md §6.2 一致;上线前由运维单独校准
FINBOARD_RISK_MAX_ORDER_VALUE=10000
FINBOARD_RISK_MAX_SYMBOL_POSITION_VALUE=30000
FINBOARD_RISK_MAX_DAILY_BUY_VALUE=50000
FINBOARD_RISK_MAX_ACTIVE_ORDERS=10
FINBOARD_RISK_MAX_ORDERS_PER_MINUTE=5
FINBOARD_RISK_ALLOW_SHORT=false
FINBOARD_RISK_ALLOW_MARKET_ORDER=false

# ====== Kill Switch 初始态 ======
# 启动时是否直接进入"暂停新单"模式(开盘前手工放行)
FINBOARD_KILL_SWITCH_NEW_ORDERS=off
