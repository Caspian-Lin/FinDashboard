root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{toml,yml,yaml,json,md,sql}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{tsx,ts,jsx,js,cjs,mjs,css,scss,html}]
indent_size = 2
